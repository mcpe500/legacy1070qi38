+// iso3: same arithmetic as quantize_row_iso3_0_ref in ggml-quants.c
+static __device__ void quantize_f32_iso3_block(const float * __restrict__ x, block_iso3_0 * __restrict__ y) {
+    float sum = 0.0f;
+    for (int j = 0; j < QK_ISO3; ++j) {
+        sum += x[j]*x[j];
+    }
+    const float norm     = sqrtf(sum);
+    const float inv_norm = norm > 1e-10f ? 1.0f/norm : 0.0f;
+
+    uint8_t qs[QK_ISO3/4]    = {0};
+    uint8_t signs[QK_ISO3/8] = {0};
+    float recon = 0.0f;
+
+#pragma unroll 4
+    for (int g = 0; g < QK_ISO3/4; ++g) {
+        const float w  = iso3_quat_w[g], qx = iso3_quat_x[g], qy = iso3_quat_y[g], qz = iso3_quat_z[g];
+        const float v0 = x[4*g + 0]*inv_norm, v1 = x[4*g + 1]*inv_norm, v2 = x[4*g + 2]*inv_norm, v3 = x[4*g + 3]*inv_norm;
+        const float r[4] = {
+            w*v0 - qx*v1 - qy*v2 - qz*v3,
+            w*v1 + qx*v0 + qy*v3 - qz*v2,
+            w*v2 - qx*v3 + qy*v0 + qz*v1,
+            w*v3 + qx*v2 - qy*v1 + qz*v0,
+        };
+#pragma unroll
+        for (int c = 0; c < 4; ++c) {
+            int idx = 0;
+#pragma unroll
+            for (int i = 0; i < 7; ++i) {
+                idx += r[c] > 0.5f*(iso3_codebook[i] + iso3_codebook[i + 1]);
+            }
+            const int j = 4*g + c;
+            qs[j/4]    |= (idx & 3) << (2*(j%4));
+            signs[j/8] |= (idx >> 2) << (j%8);
+            recon += iso3_codebook[idx]*iso3_codebook[idx];
+        }
+    }
+
+    for (int j = 0; j < QK_ISO3/4; ++j) {
+        y->qs[j] = qs[j];
+    }
+    for (int j = 0; j < QK_ISO3/8; ++j) {
+        y->signs[j] = signs[j];
+    }
+    const float recon_norm = sqrtf(recon);
+    y->norm = recon_norm > 1e-10f ? norm/recon_norm : norm;
+}
+
 static __device__ void quantize_f32_iq4_nl_block(const float * __restrict__ x, block_iq4_nl * __restrict__ y) {
