+// iso3 x f32: dequantize one block at a time (the rotation mixes the 4 values of a group)
+void ggml_vec_dot_iso3_0_f32(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(nrc == 1);
+    assert(n % QK_ISO3 == 0);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_iso3_0 * GGML_RESTRICT x = vx;
+    const float * GGML_RESTRICT y = vy;
+
+    float tmp[QK_ISO3];
+    float sumf = 0.0f;
+    for (int ib = 0; ib < n/QK_ISO3; ++ib) {
+        dequantize_row_iso3_0(x + ib, tmp, QK_ISO3);
+        double sumb = 0.0;
+        for (int j = 0; j < QK_ISO3; ++j) {
+            sumb += (double) tmp[j]*y[ib*QK_ISO3 + j];
+        }
+        sumf += (float) sumb;
+    }
+    *s = sumf;
+}
