+// ====================== iso3 (IsoQuant 3-bit, KV cache)
+
+// left product q * v of the unit quaternion of group g (conjugated when inv) with v = (v0, v1, v2, v3)
+static inline void iso3_rotate(int g, bool inv, const float * v, float * r) {
+    const float w = iso3_quat_w[g];
+    const float s = inv ? -1.0f : 1.0f;
+    const float x = s*iso3_quat_x[g], y = s*iso3_quat_y[g], z = s*iso3_quat_z[g];
+    r[0] = w*v[0] - x*v[1] - y*v[2] - z*v[3];
+    r[1] = w*v[1] + x*v[0] + y*v[3] - z*v[2];
+    r[2] = w*v[2] - x*v[3] + y*v[0] + z*v[1];
+    r[3] = w*v[3] + x*v[2] - y*v[1] + z*v[0];
+}
+
+// index of the nearest codebook entry (ties go to the lower index)
+static inline int iso3_nearest(float v) {
+    int idx = 0;
+    for (int i = 0; i < 7; ++i) {
+        idx += v > 0.5f*(iso3_codebook[i] + iso3_codebook[i + 1]);
+    }
+    return idx;
+}
+
+void quantize_row_iso3_0_ref(const float * GGML_RESTRICT x, block_iso3_0 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_ISO3 == 0);
+    const int64_t nb = k / QK_ISO3;
+
+    for (int64_t i = 0; i < nb; ++i) {
+        const float * src = x + i*QK_ISO3;
+
+        float sum = 0.0f;
+        for (int j = 0; j < QK_ISO3; ++j) {
+            sum += src[j]*src[j];
+        }
+        const float norm = sqrtf(sum);
+        const float inv_norm = norm > 1e-10f ? 1.0f/norm : 0.0f;
+
+        memset(y[i].qs,    0, sizeof(y[i].qs));
+        memset(y[i].signs, 0, sizeof(y[i].signs));
+
+        float recon = 0.0f;
+        for (int g = 0; g < QK_ISO3/4; ++g) {
+            const float v[4] = { src[4*g + 0]*inv_norm, src[4*g + 1]*inv_norm, src[4*g + 2]*inv_norm, src[4*g + 3]*inv_norm };
+            float r[4];
+            iso3_rotate(g, false, v, r);
+            for (int c = 0; c < 4; ++c) {
+                const int j   = 4*g + c;
+                const int idx = iso3_nearest(r[c]);
+                y[i].qs[j/4] |= (idx & 3) << (2*(j%4));
+                y[i].signs[j/8] |= (idx >> 2) << (j%8);
+                recon += iso3_codebook[idx]*iso3_codebook[idx];
+            }
+        }
+
+        const float recon_norm = sqrtf(recon);
+        y[i].norm = GGML_FP32_TO_FP16(recon_norm > 1e-10f ? norm/recon_norm : norm);
+    }
+}
+
+void dequantize_row_iso3_0(const block_iso3_0 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK_ISO3 == 0);
+    const int64_t nb = k / QK_ISO3;
+
+    for (int64_t i = 0; i < nb; ++i) {
+        const float norm = GGML_FP16_TO_FP32(x[i].norm);
+        for (int g = 0; g < QK_ISO3/4; ++g) {
+            float q[4];
+            for (int c = 0; c < 4; ++c) {
+                const int j = 4*g + c;
+                const int idx = ((x[i].qs[j/4] >> (2*(j%4))) & 3) | (((x[i].signs[j/8] >> (j%8)) & 1) << 2);
+                q[c] = iso3_codebook[idx];
+            }
+            float r[4];
+            iso3_rotate(g, true, q, r);
+            for (int c = 0; c < 4; ++c) {
+                y[i*QK_ISO3 + 4*g + c] = r[c]*norm;
+            }
+        }
+    }
+}
+
+size_t quantize_iso3_0(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    GGML_UNUSED(quant_weights);
+    quantize_row_iso3_0_ref(src, dst, nrow*n_per_row);
+    return nrow * ggml_row_size(GGML_TYPE_ISO3_0, n_per_row);
+}
